"""RAG memory backend using Postgres + full-text search + vector similarity."""

import re
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Optional

import numpy as np
import psycopg2
from psycopg2.extras import Json

from local_brain import config, embeddings


DB_HOST = "127.0.0.1"
DB_PORT = 5432
DB_NAME = "brainrag"
DB_USER = "raguser"
DB_PASSWORD = "localrag"

DEFAULT_DIMENSION = 384


def _connect():
    return psycopg2.connect(
        host=DB_HOST,
        port=DB_PORT,
        dbname=DB_NAME,
        user=DB_USER,
        password=DB_PASSWORD,
    )


def _vector_dimension() -> int:
    """Return the configured embedding dimension."""
    dim = config.get("embedding.dimension")
    if dim:
        return int(dim)
    return DEFAULT_DIMENSION


def init_schema() -> None:
    """Create RAG tables and indexes."""
    dim = _vector_dimension()
    with _connect() as conn:
        with conn.cursor() as cur:
            cur.execute("CREATE EXTENSION IF NOT EXISTS pg_trgm;")
            cur.execute("CREATE EXTENSION IF NOT EXISTS vector;")
            cur.execute(
                f"""
                CREATE TABLE IF NOT EXISTS memory_chunks (
                    id SERIAL PRIMARY KEY,
                    source TEXT NOT NULL,
                    source_id TEXT,
                    session_id TEXT,
                    role TEXT,
                    content TEXT NOT NULL,
                    metadata JSONB,
                    created_at TIMESTAMP DEFAULT NOW(),
                    embedding VECTOR({dim}),
                    search_vector TSVECTOR
                )
                """
            )
            cur.execute(
                "CREATE INDEX IF NOT EXISTS idx_memory_chunks_search ON memory_chunks USING GIN(search_vector)"
            )
            cur.execute(
                "CREATE INDEX IF NOT EXISTS idx_memory_chunks_source ON memory_chunks(source, session_id)"
            )
            cur.execute(
                "CREATE INDEX IF NOT EXISTS idx_memory_chunks_created ON memory_chunks(created_at DESC)"
            )
        conn.commit()


def _to_tsvector(content: str) -> str:
    """Normalize content for full-text search."""
    text = re.sub(r"```[\s\S]*?```", " ", content)
    text = re.sub(r"`[^`]+`", " ", text)
    text = re.sub(r"[^\w\s]", " ", text)
    return " ".join(text.split())


def _chunks_to_index(content: str, max_chars: int = 1500) -> List[str]:
    """Split content into chunks small enough to embed accurately."""
    # Split by headings first, then by paragraph length
    parts = re.split(r"\n(?=##\s+)", content)
    chunks = []
    for part in parts:
        part = part.strip()
        if len(part) < 30:
            continue
        if len(part) <= max_chars:
            chunks.append(part)
            continue
        # Split long parts by paragraphs
        paragraphs = part.split("\n\n")
        current = ""
        for para in paragraphs:
            if len(current) + len(para) > max_chars:
                if current:
                    chunks.append(current.strip())
                current = para
            else:
                current += "\n\n" + para if current else para
        if current:
            chunks.append(current.strip())
    return chunks


def index_chunk(
    source: str,
    content: str,
    source_id: Optional[str] = None,
    session_id: Optional[str] = None,
    role: Optional[str] = None,
    metadata: Optional[Dict[str, Any]] = None,
    created_at: Optional[datetime] = None,
) -> int:
    """Index a single text chunk into the memory store."""
    ts_text = _to_tsvector(content)
    try:
        vector = embeddings.embed([content])[0]
        vector_str = f"[{','.join(str(v) for v in vector)}]"
    except Exception:
        vector_str = None

    with _connect() as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                INSERT INTO memory_chunks
                (source, source_id, session_id, role, content, metadata, created_at, embedding, search_vector)
                VALUES (%s, %s, %s, %s, %s, %s, %s, %s::vector, to_tsvector('english', %s))
                RETURNING id
                """,
                (
                    source,
                    source_id,
                    session_id,
                    role,
                    content,
                    Json(metadata or {}),
                    created_at or datetime.now(),
                    vector_str,
                    ts_text,
                ),
            )
            row = cur.fetchone()
        conn.commit()
    return row[0]


def index_note(path: str, title: str, content: str) -> int:
    """Index a markdown note, chunked by headings."""
    count = 0
    for chunk in _chunks_to_index(content):
        if chunk.startswith("# "):
            chunk_text = chunk
        else:
            chunk_text = f"# {title}\n\n{chunk}"
        index_chunk(
            source="local-brain",
            source_id=path,
            content=chunk_text,
            metadata={"path": path, "title": title},
        )
        count += 1
    return count


def index_vault_directory(root: Path, source: str = "local-brain") -> int:
    """Index all markdown files under a directory tree."""
    count = 0
    for p in sorted(root.rglob("*.md")):
        rel = p.relative_to(root).as_posix()
        try:
            content = p.read_text(encoding="utf-8", errors="ignore")
            title = _extract_title_from_text(content) or p.stem
            for chunk in _chunks_to_index(content):
                if chunk.startswith("# "):
                    chunk_text = chunk
                else:
                    chunk_text = f"# {title}\n\n{chunk}"
                index_chunk(
                    source=source,
                    source_id=rel,
                    content=chunk_text,
                    metadata={"path": rel, "title": title, "vault": root.name},
                )
                count += 1
        except Exception:
            continue
    return count


def _extract_title_from_text(text: str) -> Optional[str]:
    """Extract first H1 or return None."""
    m = re.search(r"^#\s+(.+)$", text, re.MULTILINE)
    return m.group(1).strip() if m else None


def index_turn(
    session_id: str,
    role: str,
    content: str,
    source_id: Optional[str] = None,
    metadata: Optional[Dict[str, Any]] = None,
) -> int:
    """Index a single chat turn."""
    return index_chunk(
        source="bigus_dickus",
        source_id=source_id,
        session_id=session_id,
        role=role,
        content=content,
        metadata=metadata,
    )


def _vector_search(query: str, k: int) -> List[Dict[str, Any]]:
    """Search using vector similarity."""
    try:
        query_vector = embeddings.embed([query])[0]
        vector_str = f"[{','.join(str(v) for v in query_vector)}]"
    except Exception:
        return []

    with _connect() as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT
                    id,
                    source,
                    source_id,
                    session_id,
                    role,
                    content,
                    metadata,
                    created_at,
                    1 - (embedding <=> %s::vector) AS vector_score
                FROM memory_chunks
                WHERE embedding IS NOT NULL
                ORDER BY embedding <=> %s::vector
                LIMIT %s
                """,
                (vector_str, vector_str, k),
            )
            rows = cur.fetchall()

    return [
        {
            "id": row[0],
            "source": row[1],
            "source_id": row[2],
            "session_id": row[3],
            "role": row[4],
            "content": row[5],
            "metadata": row[6],
            "created_at": row[7].isoformat() if row[7] else None,
            "vector_score": float(row[8]) if row[8] else 0.0,
            "text_rank": 0.0,
        }
        for row in rows
    ]


def _text_search(query: str, k: int) -> List[Dict[str, Any]]:
    """Search using full-text search."""
    with _connect() as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT
                    id,
                    source,
                    source_id,
                    session_id,
                    role,
                    content,
                    metadata,
                    created_at,
                    ts_rank_cd(search_vector, query, 32) AS text_rank
                FROM memory_chunks, plainto_tsquery('english', %s) query
                WHERE search_vector @@ query
                ORDER BY text_rank DESC, created_at DESC
                LIMIT %s
                """,
                (query, k),
            )
            rows = cur.fetchall()

    return [
        {
            "id": row[0],
            "source": row[1],
            "source_id": row[2],
            "session_id": row[3],
            "role": row[4],
            "content": row[5],
            "metadata": row[6],
            "created_at": row[7].isoformat() if row[7] else None,
            "text_rank": float(row[8]) if row[8] else 0.0,
            "vector_score": 0.0,
        }
        for row in rows
    ]


def search(query: str, k: int = 5, current_session: Optional[str] = None) -> List[Dict[str, Any]]:
    """Hybrid search: combine full-text rank and vector similarity."""
    text_results = _text_search(query, k * 2)
    vector_results = _vector_search(query, k * 2)

    # Merge results by id
    by_id = {}
    for r in text_results:
        by_id[r["id"]] = r
    for r in vector_results:
        existing = by_id.get(r["id"])
        if existing:
            existing["vector_score"] = r["vector_score"]
        else:
            by_id[r["id"]] = r

    # Compute hybrid score
    max_text = max((r["text_rank"] for r in by_id.values() if r["text_rank"] > 0), default=1.0)
    for r in by_id.values():
        text_norm = r["text_rank"] / max_text if max_text > 0 else 0
        vector_norm = r["vector_score"]  # already 0-1
        r["score"] = 0.6 * text_norm + 0.4 * vector_norm

    results = sorted(by_id.values(), key=lambda x: x["score"], reverse=True)[:k]
    return results


def recent_context(session_id: str, n: int = 10) -> List[Dict[str, Any]]:
    """Get recent turns from a specific session."""
    with _connect() as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT id, source, source_id, session_id, role, content, metadata, created_at
                FROM memory_chunks
                WHERE session_id = %s
                ORDER BY created_at DESC
                LIMIT %s
                """,
                (session_id, n),
            )
            rows = cur.fetchall()
    results = []
    for row in reversed(rows):
        results.append(
            {
                "id": row[0],
                "source": row[1],
                "source_id": row[2],
                "session_id": row[3],
                "role": row[4],
                "content": row[5],
                "metadata": row[6],
                "created_at": row[7].isoformat() if row[7] else None,
            }
        )
    return results


def delete_source(source: str, source_id: Optional[str] = None) -> int:
    """Delete chunks by source (and optionally source_id)."""
    with _connect() as conn:
        with conn.cursor() as cur:
            if source_id:
                cur.execute(
                    "DELETE FROM memory_chunks WHERE source = %s AND source_id = %s",
                    (source, source_id),
                )
            else:
                cur.execute(
                    "DELETE FROM memory_chunks WHERE source = %s",
                    (source,),
                )
            count = cur.rowcount
        conn.commit()
    return count


def stats() -> Dict[str, int]:
    with _connect() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT COUNT(*) FROM memory_chunks")
            total = cur.fetchone()[0]
            cur.execute(
                "SELECT source, COUNT(*) FROM memory_chunks GROUP BY source"
            )
            by_source = {row[0]: row[1] for row in cur.fetchall()}
            cur.execute(
                "SELECT COUNT(*) FROM memory_chunks WHERE embedding IS NOT NULL"
            )
            embedded = cur.fetchone()[0]
    return {"total": total, "embedded": embedded, "by_source": by_source}
